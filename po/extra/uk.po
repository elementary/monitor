#: data/io.elementary.monitor.metainfo.xml.in:9 data/monitor.desktop.in:5
msgid "Monitor"
msgstr "Монітор"

#: data/io.elementary.monitor.metainfo.xml.in:10
msgid "Manage processes and monitor system resources"
