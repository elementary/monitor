#: data/io.elementary.monitor.metainfo.xml.in:10
msgid "Manage processes and monitor system resources"
msgstr "Gestiona procesos y monitoriza los recursos del sistema"

#: data/io.elementary.monitor.metainfo.xml.in:12
msgid "Display usage of system resources, filter and manage processes."
msgstr ""
"Muestra el uso de los recursos del sistema, filtra y gestiona procesos."

#: data/io.elementary.monitor.metainfo.xml.in:26
msgid "elementary, Inc."
