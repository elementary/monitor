msgstr "Se actualizó la traducción al japonés (Ryo Nakano)"

#: data/io.elementary.monitor.metainfo.xml.in:138
msgid "Disable search entry, when System tab is active"
msgstr ""
"Ahora se deshabilita la entrada de búsqueda, cuando la pestaña de sistema se "
"encuentra activa"

#: data/io.elementary.monitor.metainfo.xml.in:139
msgid "Add screenshots"
msgstr "Se agregaron capturas de pantalla"

#: data/io.elementary.monitor.metainfo.xml.in:146
msgid "Add System resources tab"
msgstr "Se agregó la pestaña de recursos del sistema"

#: data/io.elementary.monitor.metainfo.xml.in:153
msgid "Added tooltips to process state label (Ryo Nakano)"
msgstr ""
"Se agregaron descripciones emergentes para la etiqueta del estado del "
"proceso (Ryo Nakano)"

#: data/io.elementary.monitor.metainfo.xml.in:154
msgid "Small bugfix"
msgstr "Se realizaron correcciones menores"

#: data/io.elementary.monitor.metainfo.xml.in:161
msgid "Fix sorting arrows"
msgstr "Se corrigieron las flechas de ordenamiento"

#: data/io.elementary.monitor.metainfo.xml.in:162
#: data/io.elementary.monitor.metainfo.xml.in:198
#: data/io.elementary.monitor.metainfo.xml.in:212
